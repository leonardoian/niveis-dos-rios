# Copie pra .env (nunca commitado — ver .gitignore) e preencha.
# Só DATABASE_URL é obrigatória; o resto é opcional e cada feature vira
# no-op quando a variável falta. Detalhes de cada uma no README.

# Obrigatória — connection string do Neon.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Protege GET /api/coletar. Sem ela a rota recusa tudo (503), não libera.
# Gere com: openssl rand -hex 32
# Não é usada por scripts/coletar-local.js (não é rota exposta).
CRON_SECRET=defina-uma-string-aleatoria-aqui

# Notificações push (Web Push/VAPID). Gere o par com:
#   npx web-push generate-vapid-keys
# A pública também vai em public/js/push.js; a privada nunca sai do ambiente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Cross-check com a API oficial da ANA (hidrowebservice).
ANA_IDENTIFICADOR=
ANA_SENHA=

# Alerta de chuva acumulada (ANA). Vazio = default do código.
LIMIAR_CHUVA_6H_MM=40
JANELA_CHUVA_HORAS=6

# Alerta de subida rápida (ritmo, não patamar). Vazio = default do código.
LIMIAR_SUBIDA_CM_H=15
JANELA_SUBIDA_HORAS=3
